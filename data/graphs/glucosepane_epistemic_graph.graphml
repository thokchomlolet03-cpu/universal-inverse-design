    <node id="protein:P46073">
      <data key="d0">PROTEIN</data>
      <data key="d1">Neutral protease 2 homolog mep20</data>
      <data key="d2">Secreted metalloproteinase that allows assimilation of proteinaceous substrates. Shows high activities on basic nuclear substrates such as histone and protamine (By similarity)</data>
      <data key="d3">1.0</data>
