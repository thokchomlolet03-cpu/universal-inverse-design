    <node id="protein:P08253">
      <data key="d0">PROTEIN</data>
      <data key="d1">72 kDa type IV collagenase</data>
      <data key="d2">Mediates the proteolysis of CHUK/IKKA and initiates a primary innate immune response by inducing mitochondrial-nuclear stress signaling with activation of the pro-inflammatory NF-kappaB, NFAT and IRF transcriptional pathways</data>
