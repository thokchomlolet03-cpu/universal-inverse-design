  <graph edgedefault="directed">
    <node id="sens:extracellular_crosslinks">
      <data key="d0">DAMAGE_CLASS</data>
      <data key="d1">Extracellular Crosslinks (GlycoSENS)</data>
      <data key="d2">Advanced Glycation End-products (AGEs) like glucosepane form covalent crosslinks between collagen and elastin fibers, causing tissue stiffening, arterial hypertension, and organ failure.</data>
      <data key="d3">1.0</data>
      <data key="d4">SENS Research Foundation</data>
    </node>
    <node id="mol:glucosepane">
      <data key="d0">MOLECULE</data>
      <data key="d1">Glucosepane</data>
      <data key="d2">The most abundant Advanced Glycation End-product (AGE) crosslink in aged human tissue. A lysine-arginine crosslink with a bicyclic aminal-amidine core. Accumulates irreversibly in collagen and elastin throughout life.</data>
      <data key="d3">1.0</data>
      <data key="d4">PMID:21561553</data>
      <data key="d5">C12H22N4O4</data>
      <data key="d6">lysine-arginine</data>
    </node>
    <node id="mol:collagen">
      <data key="d0">MOLECULE</data>
      <data key="d1">Collagen (Type I)</data>
      <data key="d2">The most abundant structural protein in the human body. Primary component of the extracellular matrix.</data>
      <data key="d3">1.0</data>
      <data key="d4">UniProt</data>
    </node>
    <node id="mol:glucose">
      <data key="d0">MOLECULE</data>
      <data key="d1">D-Glucose</data>
      <data key="d2">Primary metabolic sugar. Initiates the Maillard reaction leading to AGE formation.</data>
      <data key="d3">1.0</data>
      <data key="d4">KEGG</data>
    </node>
    <node id="tissue:arteries">
      <data key="d0">TISSUE</data>
      <data key="d1">Arterial walls</data>
      <data key="d2">Blood vessel walls. Glucosepane crosslinks stiffen arterial collagen, causing hypertension.</data>
      <data key="d3">1.0</data>
      <data key="d4">PMID:21561553</data>
    </node>
    <node id="tissue:skin">
      <data key="d0">TISSUE</data>
      <data key="d1">Skin (dermis)</data>
      <data key="d2">Dermal collagen and elastin lose elasticity due to AGE crosslinking.</data>
      <data key="d3">1.0</data>
      <data key="d4">PMID:21561553</data>
    </node>
    <node id="protein:fructosamine_3_kinase">
      <data key="d0">PROTEIN</data>
      <data key="d1">Fructosamine-3-kinase (FN3K)</data>
      <data key="d2">Human enzyme that phosphorylates and destabilizes fructosamines (early glycation products). Cannot break mature glucosepane crosslinks.</data>
      <data key="d3">1.0</data>
      <data key="d4">UniProt:Q9H479</data>
      <data key="d7">Homo sapiens</data>
      <data key="d8">2.7.1.218</data>
    </node>
    <node id="protein:bacterial_class_i_enzyme">
      <data key="d0">PROTEIN</data>
      <data key="d1">Bacterial Class I-like enzyme (candidate)</data>
      <data key="d2">Candidate glucosepane-degrading enzyme identified via metagenomic screening. Demonstrated in vitro activity releasing citrulline. Selectivity and in vivo stability remain untested.</data>
      <data key="d3">0.5</data>
      <data key="d4">Patent:WO2020215043A1</data>
      <data key="d7">soil bacterium (uncharacterized)</data>
      <data key="d9">candidate</data>
    </node>
    <node id="paper:PMID_21561553">
      <data key="d0">PAPER</data>
      <data key="d1">Sell &amp; Monnier 2012 — Glucosepane: major AGE crosslink</data>
      <data key="d2">Landmark paper establishing glucosepane as the dominant AGE crosslink in human tissue.</data>
      <data key="d3">1.0</data>
      <data key="d4">PubMed</data>
      <data key="d10">2012</data>
      <data key="d11">Chem Res Toxicol</data>
    </node>
    <node id="paper:WO2020215043A1">
      <data key="d0">PAPER</data>
      <data key="d1">Patent: Glucosepane-degrading enzymes from metagenomics</data>
      <data key="d2">Patent describing enzymatic candidates for glucosepane degradation identified through metagenomic screening.</data>
      <data key="d3">1.0</data>
      <data key="d4">Patent Database</data>
      <data key="d10">2020</data>
      <data key="d12">patent</data>
    </node>
    <node id="paper:canalised_cleavage_2026">
      <data key="d0">PAPER</data>
      <data key="d1">Canalised Cleavage of Glucosepane (2026)</data>
      <data key="d2">Reports two chemical cleavage strategies: thermal (Lewis acid + alpha-effect nucleophiles) and photoredox (visible-light-driven). First convergent catalytic approach to glucosepane breakdown.</data>
      <data key="d3">1.0</data>
      <data key="d4">ChemRxiv</data>
      <data key="d10">2026</data>
      <data key="d12">preprint</data>
    </node>
    <node id="mech:maillard_reaction">
      <data key="d0">MECHANISM</data>
      <data key="d1">Maillard Reaction / Non-enzymatic Glycation</data>
      <data key="d2">Glucose reacts with lysine/arginine residues on collagen to form early glycation products, which rearrange into irreversible AGE crosslinks over years.</data>
      <data key="d3">1.0</data>
      <data key="d4">PMID:21561553</data>
    </node>
    <node id="mech:lewis_acid_cleavage">
      <data key="d0">MECHANISM</data>
      <data key="d1">Lewis Acid Thermal Cleavage of Glucosepane</data>
      <data key="d2">Uses Lewis acid and mild-acid catalysis for ring-opening, then alpha-effect nucleophiles trap the iminium intermediate.</data>
      <data key="d3">1.0</data>
      <data key="d4">ChemRxiv:canalised_cleavage_2026</data>
      <data key="d9">demonstrated_in_vitro</data>
    </node>
    <node id="mech:photoredox_cleavage">
      <data key="d0">MECHANISM</data>
      <data key="d1">Photoredox Cleavage of Glucosepane</data>
      <data key="d2">Visible-light-driven redox chemistry to cleave glucosepane. Alternative to thermal method.</data>
      <data key="d3">1.0</data>
      <data key="d4">ChemRxiv:canalised_cleavage_2026</data>
      <data key="d9">demonstrated_in_vitro</data>
    </node>
    <node id="unknown:selective_enzyme">
      <data key="d0">UNKNOWN</data>
      <data key="d1">MISSING: Selective glucosepane-cleaving enzyme</data>
      <data key="d2">No validated enzyme exists that selectively cleaves the glucosepane imidazole ring without degrading native collagen lysine-arginine bonds. Bacterial candidates exist but selectivity is untested.</data>
      <data key="d3">1.0</data>
      <data key="d4" />
      <data key="d13">CRITICAL</data>
      <data key="d14">arterial_compliance_repair</data>
    </node>
    <node id="unknown:glucosepane_crystal_structure">
      <data key="d0">UNKNOWN</data>
      <data key="d1">MISSING: 3D crystal structure of glucosepane-crosslinked collagen</data>
      <data key="d2">The exact 3D geometry of glucosepane bonded within native collagen fibers has never been experimentally resolved via X-ray crystallography or cryo-EM. Without this, rational enzyme design cannot target the exact bond geometry.</data>
      <data key="d3">1.0</data>
      <data key="d4" />
      <data key="d13">HIGH</data>
      <data key="d14">rational_enzyme_design</data>
    </node>
    <node id="unknown:in_vivo_delivery">
      <data key="d0">UNKNOWN</data>
      <data key="d1">MISSING: In vivo delivery mechanism for AGE-breaker enzymes</data>
      <data key="d2">No validated delivery vehicle exists to transport a glucosepane-cleaving enzyme into the dense extracellular matrix of aged arterial walls in a living human. Lipid nanoparticles, AAV vectors, and direct injection are all untested for this specific target.</data>
      <data key="d3">1.0</data>
      <data key="d4" />
      <data key="d13">HIGH</data>
      <data key="d14">therapeutic_deployment</data>
    </node>
    <node id="unknown:cleavage_byproduct_toxicity">
      <data key="d0">UNKNOWN</data>
      <data key="d1">MISSING: Toxicity profile of glucosepane cleavage byproducts</data>
      <data key="d2">When glucosepane crosslinks are cleaved, the fragmented molecular residues remain attached to collagen. Whether these fragments are toxic, immunogenic, or safely cleared by the body is completely unknown.</data>
      <data key="d3">1.0</data>
      <data key="d4" />
      <data key="d13">MEDIUM</data>
      <data key="d14">safety_validation</data>
    </node>
    <node id="unknown:ecm_remodeling_post_cleavage">
      <data key="d0">UNKNOWN</data>
      <data key="d1">MISSING: ECM remodeling dynamics after crosslink removal</data>
      <data key="d2">After glucosepane crosslinks are removed from collagen, will the tissue spontaneously regain youthful elasticity? Or does the ECM require active remodeling by fibroblasts to restore mechanical properties? Unknown.</data>
      <data key="d3">1.0</data>
      <data key="d4" />
      <data key="d13">MEDIUM</data>
      <data key="d14">functional_tissue_restoration</data>
    </node>
