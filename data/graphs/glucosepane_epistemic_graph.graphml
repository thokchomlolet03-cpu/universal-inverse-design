      <data key="d15">CROSSLINKS</data>
      <data key="d16">PROVEN</data>
      <data key="d17">1.0</data>
      <data key="d18">PMID:21561553</data>
      <data key="d19">glucosepane crosslinks collagen fibers via lysine-arginine</data>
    </edge>
