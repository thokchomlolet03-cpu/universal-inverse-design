# Universal Inverse Design Engine — Environment Configuration
# Copy this file to .env and fill in your values

# NCBI/PubMed API — Use a dedicated project email, NOT your personal email
NCBI_EMAIL=uid-engine-ingest@gmail.com
NCBI_API_KEY=

# LLM API for entity extraction (Phase D)
# Options: GOOGLE_API_KEY for Gemini, or OPENAI_API_KEY for OpenAI
GOOGLE_API_KEY=

# Data directories (defaults are fine for local development)
DATA_DIR=data
REPORTS_DIR=reports
